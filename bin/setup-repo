#!/usr/bin/env bash
# Sets the GitHub settings that a template copy cannot set:
# labels, workflow permissions, and branch protection on main.
#
# Usage: bin/setup-repo <owner/repo> [required check ...]
# Example: bin/setup-repo leanucci/my-gem "ci / test (3.3)"
set -euo pipefail

repo="${1:?Usage: bin/setup-repo <owner/repo> [required check ...]}"
shift

label() { gh label create "$1" --repo "$repo" --color "$2" --description "$3" --force; }
label changes-requested "d93f0b" "The review agent found blocking problems."
label review-passed     "0e8a16" "The review agent found no blocking problems."
label needs-human       "b60205" "The agents stopped. The owner must decide."
label review-round-1    "c5def5" "Fix round 1 is done."
label review-round-2    "c5def5" "Fix round 2 is done."
label review-round-3    "c5def5" "Fix round 3 is done."

# Let workflows open pull requests (spec PRs are opened by github-actions[bot]).
gh api -X PUT "repos/$repo/actions/permissions/workflow" \
  -f default_workflow_permissions=read -F can_approve_pull_request_reviews=true

checks="$(printf '%s\n' "$@" | jq -R . | jq -sc 'map(select(length > 0))')"
gh api -X PUT "repos/$repo/branches/main/protection" --input - <<JSON
{
  "required_status_checks": { "strict": false, "contexts": $checks },
  "enforce_admins": true,
  "required_pull_request_reviews": { "required_approving_review_count": 1 },
  "restrictions": null
}
JSON

echo "Done. Set the secrets with: gh secret set CLAUDE_CODE_OAUTH_TOKEN --repo $repo"
